@Name: Circle
@Version: 1.0
@Description: Circle with physically accurate 3D inverse-square infinite blur tail, 3D rotation, and translation.
@Tags: shape

@Radius: 1.0
 // Numbers of pixels (broadly)
@RimWidth: 1.0

// Proportion of RimWidth to extend blur to
@BlurWidth: 1.0 
@Rotate: 0 0 0
@Translate: 0 0 0

// Convert pixel count to world-space units. 
float pixelScale = 0.002; 
float scaledWidth = @RimWidth * pixelScale;
float halfRim = scaledWidth * 0.5;
float blurScale = @BlurWidth * @RimWidth * pixelScale;

float offset = 0.0;

// Balance probability between the uniform rim and the blur tails
float pRim = (blurScale > 0.0) ? (scaledWidth / (scaledWidth + blurScale)) : 1.0;

if (random(next) < pRim) {
    // Solid rim region (uniform distribution)
    if (scaledWidth < 1.0 && random(next) > scaledWidth) {
        return vec3(0.0/0.0); // Discard point (NaN)
    }
    offset = scaledWidth * (random(next) - 0.5);
} else {
    if (@BlurWidth == 0.0) {
        return vec3(0.0/0.0); // Discard point (NaN)
    }

    // Proportional intensity reduction if rim width is sub-pixel (< 1.0)
    if (@RimWidth < 1.0 && random(next) > @RimWidth) {
        return vec3(0.0/0.0); // Discard point (NaN)
    }

    // Clamp u safely in [0, 1) to avoid division by zero at 1.0
    float u = clamp(random(next), 0.0, 0.999999);
    
    // Exact analytical Inverse CDF for 3D Inverse-Square Law (1/r^2):
    // - At u = 0.0: curveVal = 0.0 (starts seamlessly at the rim edge)
    // - As u -> 1.0: stretches infinitely with true physical 1/r^2 decay and zero steps
    float rimIntensity = 1.0 / scaledWidth;
    float curveVal = (1.0 / sqrt(1.0 - u)) - 1.0;

    curveVal *= rimIntensity;
        
    float blurOffset = blurScale * curveVal;
    
    float side = (random(next) < 0.5) ? 1.0 : -1.0;
    offset = side * halfRim + side * blurOffset;
}

float r = @Radius + offset;

// Logarithmic center attenuation for inward-bound points
if (offset < 0.0) {
    float distNorm = clamp(r / @Radius, 0.0, 1.0);
    float logIntensity = log(1.0 + 9.0 * distNorm) / log(10.0);
    if (random(next) > logIntensity) {
        return vec3(0.0/0.0); // Discard point
    }
}

float th = 2.0 * PI * random(next);
vec3 pos = r * vec3(cos(th), sin(th), 0.0);

// Convert rotation angles from degrees to radians
vec3 rad = @Rotate * (PI / 180.0);
float cx = cos(rad.x), sx = sin(rad.x);
float cy = cos(rad.y), sy = sin(rad.y);
float cz = cos(rad.z), sz = sin(rad.z);

// Apply X, Y, and Z rotations (Z * Y * X order)
mat3 rotX = mat3(
    1.0,  0.0,  0.0,
    0.0,   cx,   sx,
    0.0,  -sx,   cx
);

mat3 rotY = mat3(
     cy,  0.0,  -sy,
    0.0,  1.0,  0.0,
     sy,  0.0,   cy
);

mat3 rotZ = mat3(
     cz,   sz,  0.0,
    -sz,   cz,  0.0,
    0.0,  0.0,  1.0
);

mat3 rot = rotZ * rotY * rotX;
return rot * pos + @Translate;