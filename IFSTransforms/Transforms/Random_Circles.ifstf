@Name: Random Circles
@Version: 1.0
@Description: Multiple randomized orbital star trails with smooth radial blur distributed within a sphere.
@Tags: shape

@Time: 0.0
@FadeupDuration: 0.1
@TotalNumber: 10
@Spread: 1.0
@MinRadius: 0.5
@MaxRadius: 2.0
@MinPathWidth: 0.1
@MaxPathWidth: 1.0
@BlurWidth: 1.0 
@StartAngle: 0.0
@OrbitCount: 1.0
@Rotate: 0 0 0
@Translate: 0 0 0

#ifndef PI
#define PI 3.14159265359
#endif


// --------------------------------------
// --  Create randomized instance vars --
// --------------------------------------

// 1. Convert random(next) decimal [0, 1) to an integer index int_n where 1 <= int_n <= @TotalNumber
int int_n = int(floor(random(next) * @TotalNumber)) + 1;

// -------------------------------------------------------------------------
// INDIVIDUAL INSTANCE FADE-UP MECHANISM
// -------------------------------------------------------------------------
// Assume instances generated at consistent speed
float spawn_time = int_n / @TotalNumber;

// Calculate how long this specific instance has been alive relative to the global @Time proxy
float instance_age = @Time - spawn_time;

// If @Time hasn't reached this instance's spawn time yet, don't render it
if (instance_age < 0.0) {
    return discarded_point;
}

// Smoothly fade up point density from black over a 1.0 second duration after birth
float fade_factor = clamp(instance_age / @FadeupDuration, 0.0, 1.0);

if (random(next) > fade_factor) {
    return discarded_point;
}

// -------------------------------------------------------------------------


// 2. Use int_n to compute deterministic spherical coordinates for the circle's center
float random_position_u1 = fract(sin(float(int_n) * 12.9898) * 43758.5453123);
float random_position_u2 = fract(sin(float(int_n) * 78.233) * 43758.5453123);
float random_position_u3 = fract(sin(float(int_n) * 141.592) * 43758.5453123);
float random_position_phi = random_position_u1 * 6.28318530718;          // Azimuth angle [0, 2*PI]
float random_position_cosTheta = 2.0 * random_position_u2 - 1.0;         // Polar spread

// Remove statistical aggregation around poles
if (abs(random_position_cosTheta) == 1.0) return discarded_point;

float random_position_sinTheta = sqrt(max(0.0, 1.0 - random_position_cosTheta * random_position_cosTheta));
float random_position_r_sphere = @Spread * pow(random_position_u3, 1.0 / 3.0);  // Uniform volumetric radius scaling bounded by @Spread

// If radius is too small (bunching at center), push it out safely
if (random_position_r_sphere < @Spread * 0.15) {
    float random_position_re_roll = random(next);
    random_position_r_sphere = @Spread * (0.15 + random_position_re_roll * 0.85);
}

float cx = random_position_r_sphere * random_position_sinTheta * cos(random_position_phi);
float cy = random_position_r_sphere * random_position_sinTheta * sin(random_position_phi);
float cz = random_position_r_sphere * random_position_cosTheta;

// Use int_n with a unique multiplier to compute decorrelated deterministic size (Radius)
float seed_size = float(int_n) * 39.727;
float size_rand = fract(sin(seed_size) * 43758.5453123);
float currentRadius = @MinRadius + size_rand * (@MaxRadius - @MinRadius);

// Compute independent RimWidth (using a completely different unique multiplier, e.g., 311.219)
float seed_rim = float(int_n) * 311.219;
float rim_rand = fract(sin(seed_rim) * 43758.5453123);

// Use int_n with a unique multiplier to compute decorrelated path width (PathWidth)
float PathWidth_Randomized = @MinPathWidth + size_rand * (@MaxPathWidth - @MinPathWidth);


// 6. Compute decorrelated random rotation angles (0 to 360 degrees) per int_n instance
float seed_rx = float(int_n) * 53.315;
float seed_ry = float(int_n) * 107.123;
float seed_rz = float(int_n) * 211.847;

float rand_rx = fract(sin(seed_rx) * 43758.5453123) * 360.0;
float rand_ry = fract(sin(seed_ry) * 43758.5453123) * 360.0;
float rand_rz = fract(sin(seed_rz) * 43758.5453123) * 360.0;

// Combine global uniform rotation (@Rotate) with instance-specific random rotation
vec3 combinedRot = @Rotate + vec3(rand_rx, rand_ry, rand_rz);

vec3 rad = combinedRot * (PI / 180.0);
float cx_rot = cos(rad.x), sx_rot = sin(rad.x);
float cy_rot = cos(rad.y), sy_rot = sin(rad.y);
float cz_rot = cos(rad.z), sz_rot = sin(rad.z);

mat3 rotX = mat3(
    1.0,    0.0,    0.0,
    0.0, cx_rot, sx_rot,
    0.0,-sx_rot, cx_rot
);

mat3 rotY = mat3(
    cy_rot, 0.0,-sy_rot,
       0.0, 1.0,    0.0,
    sy_rot, 0.0, cy_rot
);

mat3 rotZ = mat3(
    cz_rot, sz_rot, 0.0,
   -sz_rot, cz_rot, 0.0,
       0.0,    0.0, 1.0
);

mat3 rot = rotZ * rotY * rotX;

float seed_startAngle = float(int_n) * 83.123;
float rand_startAngle = fract(sin(seed_startAngle) * 43758.5453123) * 360.0;
float StartAngle_Randomized = @StartAngle + rand_startAngle;



// --------------------------------------
// ----  Create star with faded tail ----
// --------------------------------------

// 1. Base scale setup
float pixelScale = 0.002; 
float starRadius = PathWidth_Randomized * pixelScale;
float maxBlur = @BlurWidth * pixelScale;

if (PathWidth_Randomized < 1.0 && random(next) > PathWidth_Randomized) {
    return discarded_point;
}

// 2. Sample trail progress and continuous fade along the arc
float trailProgress = random(next);
float fadeFactor = 1.0 - trailProgress;
if (random(next) > fadeFactor) {
    return discarded_point;
}

// 3. Map start angle and orbit count to angular position
float startRad = StartAngle_Randomized * (PI / 180.0);
float trailRad = @OrbitCount * 2.0 * PI;
float orbital_theta = startRad - trailProgress * trailRad;

vec3 orbit_center = vec3(currentRadius * cos(orbital_theta), currentRadius * sin(orbital_theta), 0.0);

// 4. Pure radial spherical blur with a soft, smooth-falling edge distribution
float blurScale = maxBlur * (1.0 - trailProgress);
float totalRadius = starRadius + blurScale;

// Using a squared/higher power distribution tapers the density smoothly toward the outer edge 
// instead of hitting a hard geometric wall.
float u_vol = random(next);
float r_local = totalRadius * pow(u_vol, 2.0); 

float phi = random(next) * 2.0 * PI;
float cosTheta = 2.0 * random(next) - 1.0;
float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

vec3 radial_offset = r_local * vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);


// Final composition: Translate orbit position and add soft radial spherical blur
return @Translate + vec3(cx, cy, cz) + (rot * (orbit_center + radial_offset));
