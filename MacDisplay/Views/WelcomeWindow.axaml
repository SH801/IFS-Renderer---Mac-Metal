<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MacDisplay.ViewModels"
        xmlns:local="clr-namespace:MacDisplay.Views"
        WindowStartupLocation="CenterOwner" 
        ShowInTaskbar="False"
        WindowDecorations="Full"
        mc:Ignorable="d"
        Title="Welcome" 
        Height="690" Width="600"
        MinHeight="690" MinWidth="600"
        x:Name="welcomeWindow"
        x:Class="MacDisplay.Views.WelcomeWindow"
        x:DataType="vm:WelcomeViewModel"
        Background="#121212"
        Foreground="White">
        
    <Window.Resources>
        <DataTemplate x:Key="thumbnailTemplate" x:CompileBindings="False">
            <Button Width="100" Height="100" Margin="4" HorizontalAlignment="Center"
                    Command="{Binding DataContext.SelectExploreWorkflowCommand, ElementName=welcomeWindow}"
                    CommandParameter="{Binding Key}"
                    Padding="0"
                    BorderThickness="1">
                <Grid>
                    <Image Source="{Binding Value}" 
                        Stretch="UniformToFill">
                    </Image>

                    <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                            IsHitTestVisible="False" FontSize="11" Margin="5"
                            Foreground="White">
                        ▷ Explore this
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="300,*,Auto">
        <!-- Header Banner -->
        <Grid Grid.Row="0">
            <Image Stretch="UniformToFill" Source="avares://IFSRenderer/Resources/featured_artwork.jpg"/>
            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" FontSize="14">
                <HyperlinkButton NavigateUri="https://art.z97.io/" Foreground="White" Content="Artwork ↗"/>
            </TextBlock>
            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8" FontSize="48" FontWeight="Bold">
                IFSRenderer
            </TextBlock>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                <HyperlinkButton NavigateUri="https://github.com/bezo97/IFSRenderer/releases" Foreground="White" Content="Version ↗"/>
            </TextBlock>
        </Grid>
        
        <!-- Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Workflow Sidebar Card -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="4" Padding="4" Margin="2,4,0,4">
                <StackPanel MinWidth="200" Spacing="4">
                    <TextBlock FontWeight="Bold" Margin="4">Choose a workflow</TextBlock>
                    <StackPanel Margin="8,0" Spacing="4">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding SelectWorkflowCommand}" CommandParameter="{x:Static vm:WelcomeWorkflow.FromScratch}" Classes="HyperlinkButton">
                            Start from scratch
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding SelectWorkflowCommand}" CommandParameter="{x:Static vm:WelcomeWorkflow.ShowFileDialog}" Classes="HyperlinkButton">
                            Load file...
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding SelectWorkflowCommand}" CommandParameter="{x:Static vm:WelcomeWorkflow.BrowseRandoms}" Classes="HyperlinkButton">
                            Browse randoms...
                        </Button>
                    </StackPanel>
                    
                    <Button Width="182" Height="182" Margin="0,5,0,0" HorizontalAlignment="Center"
                            Command="{Binding SelectExploreWorkflowCommand}"
                            Padding="0"
                            BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding ExploreThumbnail}" 
                                Stretch="UniformToFill">
                            </Image>

                            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                                    IsHitTestVisible="False" FontSize="14" Margin="10"
                                    Foreground="White">
                                ▷ Explore this
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Expanders Panel -->
            <StackPanel Grid.Column="1" Margin="2,4" Spacing="4">
                <Expander Header="Getting Started" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
                        <StackPanel Spacing="4">
                            <HyperlinkButton NavigateUri="https://github.com/bezo97/IFSRenderer/wiki/Getting-Started-Guide" Content="Getting Started Guide ↗"/>
                            <HyperlinkButton NavigateUri="https://github.com/bezo97/IFSRenderer/wiki" Content="Wiki ↗"/>
                            <Button Command="{Binding SelectWorkflowCommand}" CommandParameter="{x:Static vm:WelcomeWorkflow.VisitSettings}" Classes="HyperlinkButton">
                                Visit Settings ⚙️
                            </Button>
                        </StackPanel>
                    </Border>
                </Expander>
                
                <Expander Header="Templates" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Templates}" ItemTemplate="{StaticResource thumbnailTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
                
                <Expander Header="Recent Files" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Border Background="#1E1E1E" Padding="8" CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentFiles}" ItemTemplate="{StaticResource thumbnailTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </StackPanel>
        </Grid>
        
        <!-- Footer Controls -->
        <Grid Grid.Row="2" Margin="4" ColumnDefinitions="*,Auto">
            <Button Grid.Column="0" Command="{Binding ContinueCommand}" IsDefault="True" HorizontalAlignment="Center" Margin="4">Continue</Button>
            <CheckBox Grid.Column="1" Command="{Binding DisableStartupCommand}"
                      IsChecked="True" VerticalAlignment="Center" HorizontalAlignment="Right">
                Show on startup
            </CheckBox>
        </Grid>
    </Grid>
</Window>