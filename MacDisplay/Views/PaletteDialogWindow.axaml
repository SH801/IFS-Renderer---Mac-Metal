<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MacDisplay.Views"
        xmlns:vm="clr-namespace:MacDisplay.ViewModels"
        mc:Ignorable="d"
        x:Name="paletteWindow"
        x:Class="MacDisplay.Views.PaletteDialogWindow"
        Width="300"
        SizeToContent="Height"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner" 
        ShowInTaskbar="False"
        WindowDecorations="Full"
        Title="Palette Picker"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        x:CompileBindings="False">
        
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Palettes}">
    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <local:PaletteButton 
                Palette="{Binding}"
                Content="{Binding Name}"
                Height="38"
                Margin="0,2,0,2"
                Command="{Binding PaletteSelectedCommand, ElementName=paletteWindow}"
                CommandParameter="{Binding}"/>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <Button Grid.Row="1" 
                Command="{Binding CancelDialogCommand}"
                IsCancel="True"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center">
            Cancel
        </Button>
    </Grid>
</Window>