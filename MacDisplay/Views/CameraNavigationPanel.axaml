<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
             xmlns:local="clr-namespace:MacDisplay.Views"
             xmlns:vm="clr-namespace:MacDisplay.ViewModels"
             x:Class="MacDisplay.Views.CameraNavigationPanel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200"
             x:Name="cameraNavigationPanel"
             Padding="0"
             x:DataType="vm:CameraSettingsViewModel">
    <StackPanel Spacing="1">
        <Grid Margin="0,0,0,10">
            <Button
                Command="{Binding AnimateCameraCommand}"
                ToolTip.Tip="Animate camera transform"
                HorizontalAlignment="Left"
                Height="20" FontSize="10" Padding="4">
                🎬 Animate Camera
            </Button>
            <Button
                Command="{Binding ResetCameraCommand}"
                ToolTip.Tip="Reset Camera"
                Height="20" FontSize="10" Padding="4"
                VerticalAlignment="Top" HorizontalAlignment="Right">
                ↩️ Reset
            </Button>
        </Grid>
        <Label Content="Position"/>
        <local:ValueSlider Value="{Binding XPos}" SliderSettings="{Binding XPosSlider}" HorizontalAlignment="Stretch"/>
        <local:ValueSlider Value="{Binding YPos}" SliderSettings="{Binding YPosSlider}" HorizontalAlignment="Stretch"/>
        <local:ValueSlider Value="{Binding ZPos}" SliderSettings="{Binding ZPosSlider}" HorizontalAlignment="Stretch"/>
        <Label Content="Orientation"/>
        <local:ValueSlider Value="{Binding XOrientation}" SliderSettings="{Binding XOrientationSlider}" HorizontalAlignment="Stretch"/>
        <local:ValueSlider Value="{Binding YOrientation}" SliderSettings="{Binding YOrientationSlider}" HorizontalAlignment="Stretch"/>
        <local:ValueSlider Value="{Binding ZOrientation}" SliderSettings="{Binding ZOrientationSlider}" HorizontalAlignment="Stretch"/>
        <local:ValueSlider Value="{Binding WOrientation}" SliderSettings="{Binding WOrientationSlider}" HorizontalAlignment="Stretch"/>
    </StackPanel>
</UserControl>